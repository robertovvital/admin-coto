# Copia estas variables en Railway → Variables tab

APP_NAME="Admin Coto"
APP_ENV=production
APP_DEBUG=false
APP_KEY=         # Railway lo genera: php artisan key:generate --show
APP_URL=         # Railway te da la URL al desplegar

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=sqlite
DB_DATABASE=/app/database/database.sqlite

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
